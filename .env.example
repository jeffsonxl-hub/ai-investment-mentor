# AI Investment Mentor Configuration
# Copy this file to .env and fill in your values.
# WARNING: .env is gitignored — NEVER commit it.

# LLM (Required)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Data Sources
TUSHARE_TOKEN=
AKSHARE_CACHE_DIR=data/cache
DATA_TIMEOUT_SECONDS=30
DATA_MAX_RETRIES=1
TUSHARE_CALL_TIMEOUT=15
AKSHARE_CALL_TIMEOUT=30
AKSHARE_PARALLEL_LIMIT=10
NEWS_DEFAULT_LIMIT=20

# Database
DB_PATH=data/ai_mentor.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ai_mentor.log
LOG_FORMAT=json

# Schedule
DAILY_ANALYSIS_TIME=08:30
